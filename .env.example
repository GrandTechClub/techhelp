# Copy this to .env for local development (never commit the real .env file).
# In production (Render/Railway/etc.), set these as environment variables
# in the hosting dashboard instead of a file.

# The spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SPREADSHEET_ID=

# The FULL contents of your service account JSON key file, as one line.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}

PORT=3000
